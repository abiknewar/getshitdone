# Copy this file to .env and fill in your own values.
# These are read by the browser (Vite), so they MUST be the *public* keys only.

# From your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# NOTE: your ANTHROPIC_API_KEY is NOT set here. It never touches the browser.
# It is set as a *secret* on the Supabase Edge Function instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# (see README.md)
# ---------------------------------------------------------------------------
